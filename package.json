{
  "name": "dikaroute",
  "version": "3.8.68",
  "description": "Unified AI router with 290 providers, RTK+Caveman compression, auto fallback, MCP/A2A, desktop, PWA, and OpenAI-compatible APIs.",
  "type": "module",
  "bin": {
    "dikaroute": "bin/dikaroute.mjs",
    "dikaroute-reset-password": "bin/reset-password.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "@dikaroute/",
    "open-sse/",
    "src/domain/",
    "src/lib/",
    "src/models/",
    "src/mitm/",
    "src/server/",
    "src/shared/",
    "src/sse/",
    "src/types/",
    ".env.example",
    "scripts/build/postinstall.mjs",
    "scripts/build/fixTlsClientNodeBinary.mjs",
    "scripts/build/fixPlaywrightAndroid.mjs",
    "bin/cli/runtime/",
    "scripts/postinstall.mjs",
    "scripts/build/postinstallSupport.mjs",
    "scripts/build/runtime-env.mjs",
    "scripts/build/colocateOptionals.mjs",
    "scripts/build/sync-env.mjs",
    "scripts/dev/responses-ws-proxy.mjs",
    "scripts/dev/tls-options.mjs",
    "scripts/check/check-supported-node-runtime.ts",
    "scripts/dev/sync-env.mjs",
    "scripts/build/native-binary-compat.mjs",
    "scripts/build/build-next-isolated.mjs",
    "scripts/build/runtime-env.mjs",
    "README.md",
    "LICENSE",
    "!**/node_modules/**",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/*.spec.ts",
    "!**/*.spec.tsx"
  ],
  "workspaces": [
    "open-sse"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.0.0 <27"
  },
  "keywords": [
    "ai",
    "router",
    "proxy",
    "openai",
    "claude",
    "anthropic",
    "gemini",
    "fallback",
    "cursor",
    "cline",
    "codex",
    "llm",
    "auto-fallback"
  ],
  "license": "MIT",
  "author": "dika",
  "repository": {
    "type": "git",
    "url": "https://github.com/dikaofc/DikaRoute"
  },
  "homepage": "https://obitoglory.tech",
  "scripts": {
    "dev": "node --max-old-space-size=${NODE_MEM:-4096} scripts/dev/run-next.mjs dev",
    "build": "node scripts/build/build-next-isolated.mjs",
    "build:backend": "cross-env DIKAROUTE_BUILD_BACKEND_ONLY=1 node scripts/build/build-next-isolated.mjs",
    "build:cli": "node --import tsx scripts/build/prepublish.ts",
    "build:secure": "DIKAROUTE_BUILD_PROFILE=minimal node scripts/build/build-next-isolated.mjs",
    "start": "node scripts/dev/run-next.mjs start",
    "lint": "eslint . --cache --cache-location .eslintcache --suppressions-location config/quality/eslint-suppressions.json",
    "typecheck:core": "tsc --pretty false -p tsconfig.typecheck-core.json",
    "postinstall": "node scripts/build/postinstall.mjs",
    "postbuild": "node scripts/build/colocate-standalone.mjs",
    "uninstall": "node scripts/build/uninstall.mjs"
  },
  "dependencies": {
